    "derivation_formula": {
      "sympy_expr": "Rational(3, 4) * P_load / (b_width * h_thickness)",
      "variables": {
        "P_load": {
          "maps_to_field": "ILSS",
          "unit": "MPa",
          "bounds": [
            0.0,
            200.0
          ]
        },
        "b_width": {
          "maps_to_field": "fiber_volume_fraction",
          "unit": "%",
          "bounds": [
            0.0,
            100.0
          ]
        },
        "h_thickness": {
          "maps_to_field": "specimen_thickness_mm",
          "unit": "mm",
          "bounds": [
            0.1,
            50.0
          ]
        }
      },
      "constraints": [
        {
          "expr": "b_width * h_thickness",
          "condition": "> 0",
          "label": "division_guard"
        }
      ],
      "verdict_threshold": {
        "ALLOW": {
          "operator": ">=",
          "value_field": "ILSS_threshold_MPa"
        },
        "REFUSE": {
          "operator": "<",
          "value_field": "ILSS_threshold_MPa"
        },
        "UNDERDETERMINED": {
          "condition": "any variable is null"
        }
      }
    },
    "status": "CANONICAL",
    "confidence_floor": 0.9,
    "required_fields": [
      {
        "field": "ILSS",
        "unit": "MPa",
        "bounds": [
          0.0,
          200.0
        ]
      },
      {
        "field": "fiber_volume_fraction",
        "unit": "%",
        "bounds": [
          0.0,
          100.0
        ]
      }
    ],
    "optional_fields": [
      {
        "field": "void_content",
        "unit": "%",
        "bounds": [
          0.0,
          10.0
        ]
      }
    ],
